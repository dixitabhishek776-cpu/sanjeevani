SANJEEVANI_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sanjeevani
REDIS_URL=redis://HOST:6379/0
SANJEEVANI_JWT_SECRET=generate-a-long-random-secret
SANJEEVANI_MASTER_KEY=generate-a-valid-32-byte-base64-key-or-use-kms
SANJEEVANI_ENCRYPTION_PROVIDER=aws_kms
SANJEEVANI_KMS_KEY_ID=arn:aws:kms:REGION:ACCOUNT:key/KEY-ID
AWS_REGION=ap-south-1
ANTHROPIC_API_KEY=replace-me
SANJEEVANI_CORS_ORIGINS=https://app.example.com
SANJEEVANI_ALERT_WEBHOOK_URL=https://your-internal-alert-endpoint.example/alerts
