# Copy this file to .env and fill in your real key.
# Get a key at https://console.anthropic.com (Anthropic Console, separate
# from your claude.ai chat account).
ANTHROPIC_API_KEY=sk-ant-your-key-here

DATABASE_URL=postgresql://sanjeevani:sanjeevani@localhost:5432/sanjeevani

# --- Encryption ---
# "local_dev" (default) uses a Fernet key kept in this file — fine for
# local development, NOT safe for any environment real users can reach.
# "aws_kms" uses a real AWS KMS Customer Master Key — see backend/README.md
# for setup (IAM permissions, key policy, region).
SANJEEVANI_ENCRYPTION_PROVIDER=local_dev

# Only used when SANJEEVANI_ENCRYPTION_PROVIDER=local_dev. Leave unset and
# the app will generate one automatically on first run (but then data
# encrypted this session becomes unreadable after a restart unless you
# copy the generated key back here).
SANJEEVANI_MASTER_KEY=

# Only used when SANJEEVANI_ENCRYPTION_PROVIDER=aws_kms:
SANJEEVANI_KMS_KEY_ID=
AWS_REGION=
# Also requires standard AWS credentials available to boto3 (env vars,
# ~/.aws/credentials, or an IAM role) — not set here.

# --- Auth / HTTP ---
# Required for production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SANJEEVANI_JWT_SECRET=
SANJEEVANI_ENV=development
SANJEEVANI_CORS_ORIGINS=http://localhost:3000

# Safety / abuse protection
SANJEEVANI_RATE_LIMIT=30
SANJEEVANI_RATE_WINDOW=60
# Optional reviewer alert delivery: webhook OR SMTP
SANJEEVANI_ALERT_WEBHOOK_URL=
SANJEEVANI_SMTP_HOST=
SANJEEVANI_SMTP_PORT=587
SANJEEVANI_SMTP_FROM=alerts@sanjeevani.local
SANJEEVANI_SMTP_TLS=1
SANJEEVANI_SMTP_USER=
SANJEEVANI_SMTP_PASSWORD=
