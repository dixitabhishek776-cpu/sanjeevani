# Copy to a secret manager; never commit real values.
SANJEEVANI_ENV=production
SANJEEVANI_JWT_SECRET=generate-a-long-random-secret
SANJEEVANI_MASTER_KEY=use-aws-kms-provider-in-production
SANJEEVANI_ENCRYPTION_PROVIDER=aws_kms
DATABASE_URL=postgresql://<managed-db>
REDIS_URL=redis://<managed-redis>
SANJEEVANI_CORS_ORIGINS=https://app.example.com
SANJEEVANI_ALLOWED_HOSTS=api.example.com
SANJEEVANI_MAX_BODY_BYTES=262144
SANJEEVANI_METRICS_TOKEN=generate-separate-monitoring-token
ANTHROPIC_API_KEY=store-in-secrets-manager
SANJEEVANI_ALERT_WEBHOOK_URL=store-in-secrets-manager

# Safety policy: keep automatic emergency-contact notification disabled until explicitly approved.
SANJEEVANI_AUTO_EMERGENCY_CONTACT_IMMEDIATE=false
